DJANGO_ENV=development
SECRET_KEY=your-secret-key-here
DEBUG=True
USE_SQLITE=False
USE_REDIS=False
ENABLE_DEFENDER=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated list of allowed CORS origins.
# For production, replace with your actual frontend domain AND include the Capacitor mobile origins:
#   capacitor://localhost  — Android app (default Capacitor scheme)
#   https://localhost      — Android app when androidScheme=https is set in capacitor.config.ts
# Example production value:
#   CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,capacitor://localhost,https://localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,https://localhost
CSRF_TRUSTED_ORIGINS=
APP_SIGNING_SECRET=REPLACE_WITH_RANDOM_64_CHAR_SECRET
JWT_SIGNING_KEY=REPLACE_WITH_RANDOM_64_CHAR_JWT_KEY
TRUSTED_PROXY_IPS=127.0.0.1

# Django Admin URL — change this to something unpredictable in production (do NOT use 'admin/')
DJANGO_ADMIN_URL=admin-replace-with-random-path/

# Admin panel registration gate — required, no default (registration disabled if unset)
ADMIN_REGISTRATION_CODE=change-this-to-a-random-secret

# Render/hosted PostgreSQL (preferred in production)
DATABASE_URL=

DB_NAME=step2win
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=

# ── Scheduled jobs (see SCHEDULED_JOBS.md) ──
# builtin (default): the daphne web process runs due jobs every ~60 s, and
#   POST /api/internal/jobs/run-due/ (called by .github/workflows/scheduled-jobs.yml)
#   runs them while the free instance would otherwise sleep.
# celery: both are off; a Celery worker started with -B runs the jobs.
# off: nothing runs automatically.
JOB_RUNNER=builtin
# Shared secret for /api/internal/jobs/run-due/ (header X-Cron-Token). Must equal the
# GitHub repository secret CRON_SECRET. Empty = the endpoint answers 404.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CRON_SECRET=

# ── Admin realtime (WebSocket /ws/admin/events/) ──
# Channel layer: auto = Redis when CHANNEL_REDIS_URL or REDIS_URL is set, else in-process
# memory (correct for a single server process). Force with redis | memory.
CHANNEL_LAYER_BACKEND=auto
# Optional: a separate Redis for the channel layer (defaults to REDIS_URL).
CHANNEL_REDIS_URL=
# Extra browser origins allowed to open the admin socket (comma-separated). The Vercel
# admin (https://step-2-win-app.vercel.app) is always allowed; localhost only when DEBUG=True.
ADMIN_WS_ALLOWED_ORIGINS=
# Kill switch for admin live updates (the console falls back to polling).
REALTIME_ENABLED=True
CELERY_RESULT_BACKEND=django-db

# Optional production hardening
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Optional override if you need to relax or tighten the default CSP
CONTENT_SECURITY_POLICY=

SENTRY_DSN=

# IntaSend Payment Gateway
# Get your API keys from:
#   Live: https://payment.intasend.com/account/api-keys/
#   Test/Sandbox: https://sandbox.intasend.com/account/api-keys/
INTASEND_API_KEY=your-intasend-secret-api-token
INTASEND_PUBLISHABLE_KEY=your-intasend-publishable-key
# Set to True to use the IntaSend sandbox environment during development
INTASEND_TEST_MODE=True
# Optional: set this to the webhook challenge key from your IntaSend dashboard
INTASEND_WEBHOOK_SECRET=REPLACE_WITH_STRONG_WEBHOOK_SECRET

# IntaSend Callback URLs (must be publicly accessible, NO auth)
# For development, use ngrok: https://your-ngrok-url.ngrok.io/api/payments/mpesa/deposit-callback/
# Register INTASEND_DEPOSIT_CALLBACK_URL as a webhook in the IntaSend dashboard (Settings > Webhooks).
# INTASEND_PAYOUT_CALLBACK_URL and INTASEND_WITHDRAWAL_CALLBACK_URL are passed per request.
INTASEND_DEPOSIT_CALLBACK_URL=https://step-2-win-app.onrender.com/api/payments/mpesa/deposit-callback/
INTASEND_PAYOUT_CALLBACK_URL=https://step-2-win-app.onrender.com/api/payments/mpesa/payout-callback/
INTASEND_WITHDRAWAL_CALLBACK_URL=https://step-2-win-app.onrender.com/api/payments/mpesa/withdrawal-callback/

# ── Sign in with Google / Apple (see step2win-web/AUTH_SETUP.md) ─────────────
# Comma-separated client ids whose ID tokens are accepted. Leave empty to disable.
# Google: <web client id>,<iOS client id>   (Android uses the web client id)
GOOGLE_OAUTH_CLIENT_IDS=
# Apple: com.step2win.app,<web Services ID, e.g. com.step2win.web>
APPLE_CLIENT_IDS=

# Email (password reset codes) - see EMAIL_SETUP.md. Unset = printed to console in development.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Step2Win <no-reply@step2win.app>
EMAIL_TIMEOUT=10
