# Sign in with Google / Apple — full steps in AUTH_SETUP.md.
# These are public client identifiers (not secrets). Leave a value empty to hide that button.
# The backend must list the same ids in GOOGLE_OAUTH_CLIENT_IDS / APPLE_CLIENT_IDS.
# Google OAuth "Web application" client id: web popup + Android (serverClientId).
VITE_GOOGLE_CLIENT_ID=
# Google OAuth "iOS" client id (bundle id com.step2win.app). Also set its reversed form
# as GOOGLE_IOS_URL_SCHEME in the Xcode build settings (see AUTH_SETUP.md).
VITE_GOOGLE_IOS_CLIENT_ID=
# Apple Services ID used by Sign in with Apple JS on the website (e.g. com.step2win.web).
# iOS needs no id (native), Android does not offer Apple sign-in yet.
VITE_APPLE_SERVICES_ID=
# Optional: popup return URL for web sign-in. Default: <site origin>/login
VITE_AUTH_REDIRECT_URL=

# Backend API base URL (no trailing slash)
# Development (browser):  http://127.0.0.1:8000
# Android emulator:       http://10.0.2.2:8000
# app.debug on phone:     https://step-2-win-app.onrender.com (or your public backend URL)
# Production:   https://step-2-win-app.onrender.com
VITE_API_BASE_URL=https://step-2-win-app.onrender.com

# Optional: explicit WebSocket base URL for real-time group chat.
# If omitted, VITE_API_BASE_URL is used with http→ws / https→wss substitution.
# Example production value: wss://step-2-win-app.onrender.com
VITE_WS_URL=

# HMAC signing secret for step-sync requests — MUST match APP_SIGNING_SECRET in the backend.
# Generate a long random string (50+ chars) and set the same value in both places.
VITE_APP_SIGNING_SECRET=REPLACE_WITH_RANDOM_64_CHAR_SECRET

# App version string sent to the backend during login for session tracking.
VITE_APP_VERSION=1.0.0
